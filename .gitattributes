* text=auto eol=lf

# Windows 脚本保留 CRLF，避免批处理换行异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 图片等二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.whl binary
*.exe binary

# 让 GitHub 语言统计正确识别
*.py linguist-language=Python
